{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KurdBooking",
  "version": "0.1.0",
  "identifier": "com.kurdbooking.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KurdBooking",
        "url": "https://kurdbooking-dlpz.vercel.app/dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#fafafc"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
