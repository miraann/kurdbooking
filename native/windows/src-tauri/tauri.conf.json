{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KurdBooking",
  "version": "0.2.0",
  "identifier": "com.kurdbooking.desktop",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KurdBooking",
        "url": "https://kurdbooking.vercel.app/dashboard",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#fafafc",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0 KurdBookingDesktop/0.2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"]
      }
    }
  }
}
