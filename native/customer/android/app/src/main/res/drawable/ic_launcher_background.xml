<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background of the customer app: zhewar's blue → red (the customer side's
     colours), so it looks different from the indigo owner app next to it.
     (top-right → bottom-left). The launcher crops it to the device's icon shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="108"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#2563EB"
                android:endColor="#EF4444" />
        </aapt:attr>
    </path>
</vector>
