# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (Project Settings → API Keys) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_…). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (sb_secret_…). The legacy "service_role" key also works.
# Server only: used for signup and for writing bookings.
SUPABASE_SECRET_KEY=

# ── Site ───────────────────────────────────────────────────────────────────
# Where the platform runs. Local: http://localhost:3000
# Before the domain is bought: your Vercel URL, e.g. https://kurd-booking.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave EMPTY until you buy the domain. While empty, shop pages live at
#   <SITE_URL>/s/<shop-slug>
# Once set (e.g. kurdbooking.com), they also live at
#   https://<shop-slug>.kurdbooking.com
# Local testing of subdomains: set it to localhost:3000 and open
#   http://ali.localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=

# Your WhatsApp, shown to shop owners on the billing page (no spaces).
NEXT_PUBLIC_SUPPORT_WHATSAPP=07701466787

# Push to the Android app (FCM). The whole JSON key from Firebase → Project
# settings → Service accounts → Generate new private key, on ONE line.
# Without it, browser push still works and the app gets no alerts.
FIREBASE_SERVICE_ACCOUNT=

# Day-before reminders (vercel.json → crons, daily 15:00 UTC). Any long random
# string. Vercel sends it to /api/cron/reminders by itself; other callers are
# refused. Without it the job still runs and can't send anything twice.
CRON_SECRET=
